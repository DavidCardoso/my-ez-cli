#!/bin/bash
set -e

# Source common utilities (works with symlinks)
SCRIPT_DIR="$(cd "$(dirname "$([ -L "$0" ] && readlink "$0" || echo "$0")")" && pwd)"
MEC_BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
. "${MEC_BASE_DIR}/bin/utils/common.sh"

# Check Docker availability
check_docker

IMAGE=${IMAGE:-"$MEC_IMAGE_NODE"}
WORKDIR=/app
NPMRC_FILE=$HOME/.npmrc
PNPM_STORE_DIR=${PNPM_STORE_DIR:-"$HOME/.local/share/pnpm/store"}
CONTAINER_PNPM_HOME="/root/.local/share/pnpm"
CONTAINER_PNPM_STORE_DIR="$CONTAINER_PNPM_HOME/store"
COREPACK_HOME=${COREPACK_HOME:-"$HOME/.cache/node/corepack"}
CONTAINER_COREPACK_HOME=${CONTAINER_COREPACK_HOME:-"/root/.cache/node/corepack"}

# Create .npmrc if it doesn't exist
if [ ! -f "$NPMRC_FILE" ]; then
    touch "$NPMRC_FILE"
fi

# Create pnpm store folder if it doesn't exist (persistent, content-addressable)
if [ ! -d "$PNPM_STORE_DIR" ]; then
    mkdir -p "$PNPM_STORE_DIR"
fi

# Create corepack cache folder if it doesn't exist. Without this, corepack
# re-fetches the pnpm tarball from the npm registry on every invocation,
# which is slow and fails intermittently under network/registry hiccups.
if [ ! -d "$COREPACK_HOME" ]; then
    mkdir -p "$COREPACK_HOME"
fi

# Container naming and labeling
CONTAINER_NAME=$(get_container_name "pnpm")
CONTAINER_LABELS=$(get_container_labels "pnpm" "$IMAGE")

# Get port flags from MEC_BIND_PORTS
PORTS=$(get_port_flags)

# Setup logging (if enabled)
setup_logging "pnpm" "$IMAGE" "pnpm ${*}"

# pnpm ships via corepack rather than being preinstalled on the node image,
# so activate a pinned version before exec-ing into it. corepack's own
# download cache is mounted from the host so the pnpm tarball is fetched
# once, not on every invocation.
# This script string is a single argv element passed to the container's
# `sh -c` — it is never re-parsed by the host shell (no eval), so $@ here
# stays literal for the container's sh to expand.
PNPM_SH_SCRIPT='corepack enable pnpm >/dev/null 2>&1 && corepack prepare pnpm@'"$MEC_PNPM_VERSION"' --activate && exec pnpm "$@"'

# Build docker command as an array — never as a string handed to eval,
# so shell metacharacters in $PWD (or any other value) can't be
# re-interpreted as commands (see GHSA-3vmh-fm2p-pcv2).
DOCKER_CMD=(docker run -i)
TTY_FLAG=$(get_tty_flag)
[ -n "$TTY_FLAG" ] && DOCKER_CMD+=("$TTY_FLAG")
DOCKER_CMD+=(--rm --name "$CONTAINER_NAME")
# shellcheck disable=SC2206  # CONTAINER_LABELS/PORTS are internally built flag lists, word-split by design
DOCKER_CMD+=($CONTAINER_LABELS)
DOCKER_CMD+=(
    --env "NPM_TOKEN=$NPM_TOKEN"
    --env "PNPM_HOME=$CONTAINER_PNPM_HOME"
    --env "pnpm_config_store_dir=$CONTAINER_PNPM_STORE_DIR"
    --env "npm_config_store_dir=$CONTAINER_PNPM_STORE_DIR"
    --env "COREPACK_HOME=$CONTAINER_COREPACK_HOME"
    --volume "$NPMRC_FILE:/root/.npmrc"
    --volume "$PNPM_STORE_DIR:$CONTAINER_PNPM_STORE_DIR"
    --volume "$COREPACK_HOME:$CONTAINER_COREPACK_HOME"
    --volume "$PWD:$WORKDIR"
    --workdir "$WORKDIR"
)
# shellcheck disable=SC2206
DOCKER_CMD+=($PORTS)
DOCKER_CMD+=(--entrypoint sh "$IMAGE" -c "$PNPM_SH_SCRIPT" sh "$@")

# Execute with AI analysis (port detection for dev servers)
exec_with_ai "${DOCKER_CMD[@]}"
