#!/bin/bash
set -e

# Source common utilities (works with symlinks)
SCRIPT_DIR="$(cd "$(dirname "$([ -L "$0" ] && readlink "$0" || echo "$0")")" && pwd)"
MEC_BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# override default image
export IMAGE="node:20-alpine"

# pnpm 11 requires Node.js >=22 (pure ESM); pin the last pnpm 10.x line for Node 20,
# which still supports minimumReleaseAge (added in v10.16.0). Force-set: by the time this
# runs via `mec pnpm20`, common.sh has already exported MEC_PNPM_VERSION from images.conf,
# so a soft `${VAR:-default}` here would never take effect.
export MEC_PNPM_VERSION="10.33.4"

# import & run the local default pnpm script
. "${MEC_BASE_DIR}/bin/pnpm"
